# ── Copy this file to .env and fill in. In GitHub, add each as a repo Secret. ──

# Google Gemini (FREE tier) — get at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# YouTube Data API v3 OAuth (see README "Getting Started")
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ── Behaviour toggles ────────────────────────────────────────────────────────
# public | unlisted | private  (invalid values fall back to 'private')
YT_PRIVACY=public
# true = upload as private for manual review.  false = fully automatic.
REVIEW_BEFORE_PUBLISH=false

# ── Voice / language ─────────────────────────────────────────────────────────
TTS_VOICE=en-US-JennyNeural
TTS_RATE=+16%
TTS_PITCH=+8Hz
TTS_VOLUME=+14%
# Script language label (e.g. English, Hindi, Hinglish)
LANGUAGE=English

# ── Topic selection ──────────────────────────────────────────────────────────
# rotate = fixed daily cycle | trending = pick the topic with the most fresh news
TOPIC_STRATEGY=rotate
TOPIC_COOLDOWN=2

# ── A/B testing of titles + thumbnails ───────────────────────────────────────
AB_TESTING=true

# ── Analytics loop (optional) ────────────────────────────────────────────────
# true + a YouTube Data API key lets the pipeline learn from past view counts.
ENABLE_ANALYTICS=false
YT_DATA_API_KEY=
ANALYTICS_LOOKBACK=30

# ── Operational (optional) ───────────────────────────────────────────────────
REMOTION_SCALE=0.75
LOG_LEVEL=INFO
MIN_AUDIO_SECONDS=15
# Failure alerting. In GitHub Actions, GITHUB_TOKEN is provided automatically and
# opens an issue on failure. For Slack, set:
SLACK_WEBHOOK_URL=
